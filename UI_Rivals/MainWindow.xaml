                                </ui:CardControl.Header>
                                <ui:CardControl.Content>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                                        <StackPanel Margin="0,0,10,0">
                                            <!-- Toggle Settings Section -->
                                            <Border Style="{StaticResource SettingsContainerStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Toggle Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                                                    <!-- Status Setting -->
                                                    <Grid Margin="0,8,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Status" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Enable or disable the application functionality" FontSize="12" Foreground="#6C757D" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock x:Name="StatusText" Text="False" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="Medium"/>
                                                            <ToggleButton x:Name="StatusToggle" Style="{StaticResource CustomToggleButtonStyle}" 
                                                                  Checked="StatusToggle_Checked" Unchecked="StatusToggle_Unchecked"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Shot While Moving Setting -->
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Shot While Moving" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Allow shots to be fired while moving" FontSize="12" Foreground="#6C757D" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock x:Name="ShotWhileMovingText" Text="False" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="Medium"/>
                                                            <ToggleButton x:Name="ShotWhileMovingToggle" Style="{StaticResource CustomToggleButtonStyle}" 
                                                                  Checked="ShotWhileMovingToggle_Checked" Unchecked="ShotWhileMovingToggle_Unchecked"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Method and Color Settings Section -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Shooting Method -->
                                                <Border Grid.Column="0" Style="{StaticResource SettingsContainerStyle}" Margin="0,8,5,8">
                                                    <StackPanel>
                                                        <TextBlock Text="Shooting Method" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                                        <RadioButton x:Name="PressButtonOption" Content="Press Button" Style="{StaticResource OptionButtonStyle}" 
                                                             GroupName="ShootingMethod" IsChecked="True" Checked="ShootingMethod_Checked"/>
                                                        <RadioButton x:Name="HoldButtonOption" Content="Hold Button" Style="{StaticResource OptionButtonStyle}" 
                                                             GroupName="ShootingMethod" Checked="ShootingMethod_Checked"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Color Detection -->
                                                <Border Grid.Column="1" Style="{StaticResource SettingsContainerStyle}" Margin="5,8,5,8">
                                                    <StackPanel>
                                                        <TextBlock Text="Color Detection" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                                        <RadioButton x:Name="RedOption" Content="Red" Style="{StaticResource OptionButtonStyle}" 
                                                             GroupName="ColorDetection" IsChecked="True" Checked="ColorDetection_Checked"/>
                                                        <RadioButton x:Name="PurpleOption" Content="Purple" Style="{StaticResource OptionButtonStyle}" 
                                                             GroupName="ColorDetection" Checked="ColorDetection_Checked"/>
                                                        <RadioButton x:Name="YellowOption" Content="Yellow" Style="{StaticResource OptionButtonStyle}" 
                                                             GroupName="ColorDetection" Checked="ColorDetection_Checked"/>
                                                        <RadioButton x:Name="PurpleReynaUltOption" Content="Purple (Reyna)" Style="{StaticResource OptionButtonStyle}" 
                                                             GroupName="ColorDetection" Checked="ColorDetection_Checked"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Shooting Delay -->
                                                <Border Grid.Column="2" Style="{StaticResource SettingsContainerStyle}" Margin="5,8,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="Shooting Delay" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                                        <RadioButton x:Name="VandalOption" Content="VANDAL" Style="{StaticResource OptionButtonStyle}" 
                                                             GroupName="ShootingDelay" IsChecked="True" Checked="ShootingDelay_Checked"/>
                                                        <RadioButton x:Name="GuardianOption" Content="GUARDIAN" Style="{StaticResource OptionButtonStyle}" 
                                                             GroupName="ShootingDelay" Checked="ShootingDelay_Checked"/>
                                                        <RadioButton x:Name="SherifOption" Content="SHERIF" Style="{StaticResource OptionButtonStyle}" 
                                                             GroupName="ShootingDelay" Checked="ShootingDelay_Checked"/>
                                                        <RadioButton x:Name="PhantomOption" Content="PHANTOM" Style="{StaticResource OptionButtonStyle}" 
                                                             GroupName="ShootingDelay" Checked="ShootingDelay_Checked"/>
                                                        <RadioButton x:Name="GhostOption" Content="GHOST" Style="{StaticResource OptionButtonStyle}" 
                                                             GroupName="ShootingDelay" Checked="ShootingDelay_Checked"/>
                                                        <RadioButton x:Name="NoDelayOption" Content="NO DELAY" Style="{StaticResource OptionButtonStyle}" 
                                                             GroupName="ShootingDelay" Checked="ShootingDelay_Checked"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>


                                        </StackPanel>
                                    </ScrollViewer>
                                </ui:CardControl.Content>
                            </ui:CardControl>
                        </ui:Card>
                    </Grid>

                    <!-- Default welcome view -->
                    <Grid x:Name="DefaultView" Visibility="Collapsed">
                        <ui:Card Margin="30" Background="White" Opacity="0.85">
                            <ui:CardControl>
                                <ui:CardControl.Header>
                                    <TextBlock Text="Welcome" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
                                </ui:CardControl.Header>
                                <ui:CardControl.Content>
                                    <StackPanel x:Name="MainContent">
                                        <TextBlock x:Name="WelcomeText" Text="Welcome to the Exodus!" FontWeight="Bold" FontSize="18"/>
                                        <TextBlock Text="Optimize your gaming experience" Opacity="0.7" Margin="0,8,0,18"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                                            <TextBlock x:Name="CloseRightLabel" Text="Close Right: " FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CloseRightText" Text="True" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            <TextBlock x:Name="OpenRightLabel" Text="Open Right: " FontSize="14" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <TextBlock x:Name="OpenRightText" Text="True" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="CloseRightToggle" Content="Toggle Close Right" Margin="0,12,0,0" Padding="12,8"/>
                                        <Button x:Name="MainButton" Content="Click me!" Margin="0,12,0,0" Padding="12,8" Background="#4361EE" Foreground="White">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </ui:CardControl.Content>
                            </ui:CardControl>
                        </ui:Card>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>