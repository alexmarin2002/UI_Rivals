<Window x:Class="UI_Rivals.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI_Rivals"
        mc:Ignorable="d"
        Height="580" Width="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Fonts -->
        <FontFamily x:Key="MainFont">Segoe UI</FontFamily>
        <FontFamily x:Key="TitleFont">Segoe UI Semibold</FontFamily>

        <!-- Button Styles -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#33000000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                            <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinimizeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#33000000"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                            <TextBlock Text="−" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#60FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorToggleStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="14" Width="28" Height="28" 
                                Opacity="0.9">
                            <Grid>
                                <Ellipse x:Name="checkMark" Width="14" Height="14" Fill="White" Opacity="0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="1" Direction="315" Opacity="0.3" BlurRadius="2"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Opacity" Value="1"/>
                                <Setter TargetName="border" Property="Opacity" Value="1"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0" Direction="0" Opacity="0.5" BlurRadius="10" Color="{Binding Background.Color, ElementName=border}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="BackgroundBorder" Background="#2A2A3A" CornerRadius="10" Width="42" Height="20">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1" Direction="270" Opacity="0.2" BlurRadius="4"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Indicator" Background="White" CornerRadius="8" Width="16" Height="16" 
                                    HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1" Direction="270" Opacity="0.3" BlurRadius="2"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Indicator" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=Tag}"/>
                                <Setter TargetName="BackgroundBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0" Direction="0" Opacity="0.4" BlurRadius="8" Color="{Binding Tag.Color, RelativeSource={RelativeSource AncestorType=Grid}}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter TargetName="Indicator" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="2" Direction="270" Opacity="0.4" BlurRadius="4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                BorderBrush="#22FFFFFF" 
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" Direction="270" Opacity="0.2" BlurRadius="4"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyBindButton" TargetType="Button">
            <Setter Property="Background" Value="#252535"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" Direction="270" Opacity="0.2" BlurRadius="4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#353550"/>
                                <Setter Property="BorderBrush" Value="#66FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#454565"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Slider Style -->
        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="#4A6EF5"/>
            <Setter Property="Background" Value="#333344"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="TrackBackground" Grid.Row="1" Height="4" Margin="5,0" CornerRadius="2" 
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_SelectionRange" Grid.Row="1" Height="4" Margin="5,0" CornerRadius="2" 
                                    Background="{TemplateBinding Foreground}"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderBrush="Transparent"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderBrush="Transparent"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Grid>
                                                    <Ellipse Fill="White">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect ShadowDepth="1" Direction="270" Opacity="0.3" BlurRadius="3"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse Width="6" Height="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Title Style -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,14,0,5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" Direction="270" Opacity="0.3" BlurRadius="1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Margin="5">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#161625" Offset="0"/>
                <GradientStop Color="#1E1E35" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" Direction="270" Opacity="0.3" BlurRadius="10"/>
        </Border.Effect>
        <Border CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Window Header with Gradient -->
                <Border Grid.Row="0" Height="60" CornerRadius="10,10,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#252540" Offset="0"/>
                            <GradientStop Color="#303055" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="EXODUS SERVICES" FontSize="16" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource TitleFont}">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="1" Direction="270" Opacity="0.5" BlurRadius="2"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="Rivals Triggerbot - Public Version 1.0" FontSize="11" Foreground="#AAB0C3" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,10,10,0">
                            <Button Style="{StaticResource MinimizeButtonStyle}" Click="MinimizeButton_Click" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Settings Content -->
                <Grid Grid.Row="1" Margin="18,6,18,18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Status Toggle -->
                            <Grid Margin="0,12,0,0" Tag="#4A6EF5">
                                <TextBlock Text="Triggerbot Status" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                <CheckBox x:Name="StatusToggle" Style="{StaticResource ModernToggleSwitch}" 
                                          HorizontalAlignment="Right" Checked="StatusToggle_Checked" Unchecked="StatusToggle_Unchecked"/>
                            </Grid>

                            <Border Height="1" Background="#15FFFFFF" Margin="0,14,0,0"/>

                            <!-- Color Selection -->
                            <TextBlock Text="Target Color" Style="{StaticResource SectionTitleStyle}" Margin="0,14,0,8"/>

                            <Grid Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel Margin="0,0,24,0">
                                        <RadioButton x:Name="BlueColor" GroupName="ColorGroup" Style="{StaticResource ColorToggleStyle}"
                                               Background="#4A6EF5" Checked="ColorOption_Checked" IsChecked="True" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Blue" Foreground="White" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,24,0">
                                        <RadioButton x:Name="RedColor" GroupName="ColorGroup" Style="{StaticResource ColorToggleStyle}"
                                               Background="#F54A6E" Checked="ColorOption_Checked" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Red" Foreground="White" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <RadioButton x:Name="YellowColor" GroupName="ColorGroup" Style="{StaticResource ColorToggleStyle}"
                                               Background="#F5DE4A" Checked="ColorOption_Checked" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Yellow" Foreground="White" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#15FFFFFF" Margin="0,14,0,0"/>

                            <!-- Keybind -->
                            <TextBlock Text="Activation Key" Style="{StaticResource SectionTitleStyle}" Margin="0,14,0,8"/>
                            <Button x:Name="KeybindButton" Content="Press to rebind [F]" Style="{StaticResource KeyBindButton}"
                                    Click="KeybindButton_Click" Margin="0,6,0,0"/>

                            <Border Height="1" Background="#15FFFFFF" Margin="0,14,0,0"/>

                            <!-- Shooting Delay -->
                            <TextBlock Text="Shooting Delay (ms)" Style="{StaticResource SectionTitleStyle}" Margin="0,14,0,8"/>
                            <TextBox x:Name="DelayTextBox" Style="{StaticResource ModernTextBox}" 
                                     PreviewTextInput="NumberValidationTextBox" Text="150"
                                     TextChanged="DelayTextBox_TextChanged" Margin="0,6,0,0"/>

                            <Border Height="1" Background="#15FFFFFF" Margin="0,14,0,0"/>

                            <!-- Pixel Range -->
                            <Grid Margin="0,14,0,8">
                                <TextBlock Text="Pixel Range" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                <TextBlock x:Name="PixelRangeText" Text="5" Foreground="#4A6EF5" FontWeight="Bold" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            </Grid>
                            <Slider x:Name="PixelRangeSlider" Minimum="1" Maximum="10" Value="5" 
                                    ValueChanged="PixelRangeSlider_ValueChanged" Style="{StaticResource ModernSliderStyle}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"/>

                            <!-- Footer -->
                            <Border Height="1" Background="#15FFFFFF" Margin="0,20,0,0"/>
                            <TextBlock Text="© 2023 Exodus Services" Foreground="#50FFFFFF" FontSize="10" 
                                   HorizontalAlignment="Center" Margin="0,20,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>