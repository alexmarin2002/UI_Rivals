<Window x:Class="UI_Rivals.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI_Rivals"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Exodus Services - Valorant" Height="650" Width="950"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Custom style for sidebar buttons -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="8,8,8,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" 
                                           Margin="10,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="Center" 
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>

                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A56D4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2E46B9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom style for toggle switches -->
        <Style x:Key="CustomToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="BackgroundElement" Background="#E0E0E0" Width="50" Height="24" CornerRadius="12">
                                <Border x:Name="ThumbElement" Width="20" Height="20" Background="White" CornerRadius="10" 
                                        HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.3" Direction="270"/>
                                    </Border.Effect>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundElement" Property="Background" Value="#4361EE"/>
                                <Setter TargetName="ThumbElement" Property="Margin" Value="28,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom style for option buttons -->
        <Style x:Key="OptionButtonStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="#303030"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Border" 
                                    Background="Transparent" 
                                    BorderBrush="#DDDDDD" 
                                    BorderThickness="1" 
                                    CornerRadius="6"
                                    Padding="6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="RadioMark" 
                                             Width="16" 
                                             Height="16" 
                                             Stroke="#BBBBBB" 
                                             StrokeThickness="1.5" 
                                             HorizontalAlignment="Center" 
                                             VerticalAlignment="Center"/>
                                    <Ellipse x:Name="CheckMark" 
                                             Width="8" 
                                             Height="8" 
                                             Fill="#4361EE" 
                                             Visibility="Collapsed" 
                                             HorizontalAlignment="Center" 
                                             VerticalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1" 
                                                    Margin="10,0,0,0" 
                                                    VerticalAlignment="Center" 
                                                    HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="RadioMark" Property="Stroke" Value="#4361EE"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4361EE"/>
                                <Setter TargetName="Border" Property="Background" Value="#F0F4FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#F7F9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom style for settings containers -->
        <Style x:Key="SettingsContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="10" Opacity="0.1" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sync button style -->
        <Style x:Key="SyncButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,5"/>
            <Setter Property="Margin" Value="0,20,0,5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0EA371"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0C8D61"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#F7F9FF"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8">
                            <Grid>
                                <!-- Removed Margin from ScrollViewer -->
                                <ScrollViewer x:Name="PART_ContentHost"
											  VerticalAlignment="Center"/>
                                <TextBlock x:Name="WatermarkText"
										   Text="{TemplateBinding Tag}"
										   Foreground="#AAAAAA"
										   VerticalAlignment="Center"
										   Margin="15,0,0,0"
										   Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="WatermarkText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#4361EE"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4361EE"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="WatermarkText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Static sys:String.Empty}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                <Setter TargetName="WatermarkText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- Login Button Style -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,15,0,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" 
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A56D4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2E46B9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BBBBBB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Remember Me Checkbox Style -->
        <Style x:Key="RememberMeCheckboxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#303030"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxBorder"
                            Width="18"
                            Height="18"
                            Background="White"
                            BorderBrush="#BBBBBB"
                            BorderThickness="1.5"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                              Width="10"
                              Height="10"
                              Data="M1,5 L3.5,7.5 L7,2"
                              Stroke="#FFFFFF"
                              StrokeThickness="2"
                              Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#4361EE"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#4361EE"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#4361EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Login View -->
        <Grid x:Name="LoginView" ZIndex="1000">
            <Border Background="#1E1E2D" CornerRadius="10" Opacity="0.95">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Side - Login Image Background -->
                    <Border Grid.Column="0">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/main-bg.jpg" 
                                Stretch="UniformToFill" Opacity="0.9"/>
                        </Border.Background>
                        <Grid>
                            <!-- Overlay -->
                            <Border Background="#1E1E2D" Opacity="0.5"/>

                            <!-- Logo and Text -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="EXODUS" Foreground="White" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="SERVICES" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-5,0,15"/>
                                <TextBlock Text="Valorant Triggerbot" Foreground="#AAAAAA" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                <TextBlock Text="AMD GPU" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="Public Version 1.5" Foreground="#AAAAAA" FontSize="14" HorizontalAlignment="Center"/>

                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Side - Login Form -->
                    <Border Grid.Column="1" Background="#FFFFFF">
                        <Grid Margin="35,25">
                            <!-- Login Form -->
                            <StackPanel VerticalAlignment="Center" Margin="0,15">
                                <TextBlock Text="Welcome Back" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock Text="Sign in to continue" FontSize="14" Foreground="#6C757D" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                                <!-- Username Input -->
                                <TextBlock Text="License Key" FontSize="13" FontWeight="Medium" Margin="0,5,0,0"/>
                                <TextBox x:Name="UsernameTextBox"
         Tag="Enter your license"
         Style="{StaticResource LoginInputStyle}" TextChanged="UsernameTextBox_TextChanged" />


                                <!-- Error Message Panel -->
                                <Border x:Name="ErrorMessagePanel"
										Background="#FFF0F0"
										BorderBrush="#FFD6D6"
										BorderThickness="1"
										CornerRadius="4"
										Margin="0,8,0,8"
										Padding="12,8"
										Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Error Icon -->
                                        <TextBlock Grid.Column="0"
												   Text="⚠"
												   FontSize="14"
												   Foreground="#E74C3C"
												   VerticalAlignment="Center"
												   Margin="0,0,8,0"/>

                                        <!-- Error Message -->
                                        <TextBlock x:Name="ErrorMessageText"
												   Grid.Column="1"
												   Text="Invalid license key. Please check and try again."
												   Foreground="#E74C3C"
												   FontSize="12"
												   TextWrapping="Wrap"
												   VerticalAlignment="Center"/>

                                        <!-- Close Button -->
                                        <Button Grid.Column="2"
												Content="✕"
												Background="Transparent"
												BorderThickness="0"
												Foreground="#E74C3C"
												FontSize="12"
												Width="16"
												Height="16"
												Padding="0"
												VerticalAlignment="Top"
												HorizontalAlignment="Right"
												Click="CloseErrorMessage_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Remember Me & Forgot Password -->
                                <Grid Margin="0,5,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="RememberMeCheckbox" Content="Remember me" Style="{StaticResource RememberMeCheckboxStyle}"/>
                                    <TextBlock Grid.Column="1" Text="Need Help?" Foreground="#4361EE" FontSize="13" 
                                       VerticalAlignment="Center" Cursor="Hand" MouseDown="NeedHelp_MouseDown"/>
                                </Grid>

                                <!-- Sign In Button -->
                                <Button x:Name="SignInButton" Content="Sign In" Style="{StaticResource LoginButtonStyle}" Click="SignInButton_Click"/>

                                <!-- Register Option -->
                                <TextBlock Margin="0,25,0,0" HorizontalAlignment="Center">
                            <Run Text="Don't have a License?" Foreground="#6C757D"/>
                            <Run Text="Buy One" Foreground="#4361EE" MouseDown="BuyOne_MouseDown" Cursor="Hand"/>
                                </TextBlock>

                                <!-- Status Message -->
                                <TextBlock x:Name="StatusMessage" Text="" Foreground="#FF3333" FontSize="13" 
                                   HorizontalAlignment="Center" Margin="0,15,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="MainAppUI" Visibility="Collapsed">

            <!-- Main Background Image using relative path -->
            <Grid.Background>
                <ImageBrush ImageSource="pack://application:,,,/main-bg.jpg" 
                        Stretch="UniformToFill" Opacity="0.85"/>
            </Grid.Background>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6"/>
                <ColumnDefinition Width="218.4"/>
                <!-- Sidebar - increased width to accommodate larger buttons -->
                <ColumnDefinition Width="*"/>
                <!-- Main Content -->
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar with Buttons -->
            <Border Background="#1E1E2D" Opacity="0.75" CornerRadius="0,0,0,0" Grid.ColumnSpan="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- App Title -->
                    <StackPanel Grid.Row="0" Margin="0,20,0,30">
                        <!-- Logo Icon -->
                        <Path Data="" Fill="#6C5CE7" HorizontalAlignment="Center" Height="18" Width="18" Margin="0,0,0,10"/>

                        <TextBlock Text="EXODUS SERVICES" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Valorant Triggerbot" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="AMD GPU" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>


                        <!-- Version Badge -->
                        <Border Background="#6C5CE7" CornerRadius="10" Padding="8,3" Margin="0,5,0,0" HorizontalAlignment="Center" Width="110">
                            <TextBlock Text="Public Version 1.5" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Navigation Menu -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="" Foreground="#6C757D" FontSize="12" Margin="8,0,15,10" />

                        <!-- General Settings Button -->
                        <Button Content="General" Click="ShowGlobalSettingsView_Click" Style="{StaticResource SidebarButtonStyle}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Settings Icon (white) -->
                                        <Path Data="M9.4,16.6L4.8,12l4.6-4.6L8,6l-6,6l6,6L9.4,16.6z M14.6,16.6l4.6-4.6l-4.6-4.6L16,6l6,6l-6,6L14.6,16.6z" 
                                  Fill="White" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" Foreground="White" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                        <!-- Weapon Delay Button -->
                        <Button Content="Weapon Delay" Click="ShowMacroSettingsView_Click" Style="{StaticResource SidebarButtonStyle}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Weapon Icon (white) -->
                                        <Path Data="M7,5L3,7V3L7,5z M18,3v4l4-2L18,3z M11,2v14h2V2H11z M7,7v14h2V7H7z M16,7v14h2V7H16z" 
                                  Fill="White" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" Foreground="White" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                        <!-- Settings Button -->
                        <Button Content="Settings" Click="ShowSettingsView_Click" Style="{StaticResource SidebarButtonStyle}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Settings Icon (white) -->
                                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" 
                                  Fill="White" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" Foreground="White" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                        <!-- User Info / Help Button -->
                        <Button Content="User Info / Help" Click="ShowUserInfoView_Click" Style="{StaticResource SidebarButtonStyle}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Help Icon (white) -->
